{
  // Baku: archivos estáticos + un puente para buscar en Open Food Facts
  "name": "baku",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Cada hora: mantiene despierta la base de datos (Supabase gratis se duerme a la semana sin uso)
  // y revisa si a alguien le toca un recordatorio
  "triggers": { "crons": ["0 * * * *"] }
}
